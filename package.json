{
  "name": "fogsea-survival",
  "private": true,
  "version": "2.0.2",
  "description": "雾海生存 FogSea Survival v2 - 基于小说机制重构的迷雾求生策略游戏 (Vue3 + TS monorepo)",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "validate": "pnpm -F @fogsea/core validate",
    "dev:web": "pnpm --filter @fogsea/web dev",
    "dev": "pnpm dev:web"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.11.0"
}
