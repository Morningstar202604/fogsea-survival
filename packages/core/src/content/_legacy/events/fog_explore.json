            "effects": { "sanity": -4 } } ]
        }
      ]
    },
    {
      "id": "evt_deepfog_altar", "title": "雾中之台", "type": "explore", "pool": ["deep_fog"],
      "weight": 20, "once": false, "cooldownDays": 3,
      "text": "火把的光只能推开半米浓雾。雾中忽然浮现出一座石台，台上凹槽的形状——和你口袋里的结晶一模一样。",
      "options": [
