            { "weight": 50, "text": "井底的「软东西」是一个前人留下的背包！里面的物资保存完好。",
              "effects": { "loseItems": [ { "itemId": "mat_rope", "count": 1 } ], "gainItems": [ { "itemId": "med_first_aid", "count": 1 }, { "itemId": "food_biscuit", "count": 1 } ] } },
            { "weight": 50, "text": "背包旁边靠着一具白骨，手里攥着半张地图。你礼貌地道了歉，取走了地图和背包里的药。",
              "effects": { "loseItems": [ { "itemId": "mat_rope", "count": 1 } ], "gainItems": [ { "itemId": "key_map_fragment", "count": 1 }, { "itemId": "med_painkiller", "count": 1 } ], "sanity": -10 } }
          ]
        },
        { "text": "对着井口大喊一声",
          "results": [
            { "weight": 100, "text": "「喂——」回声散尽后，井底传来极轻极轻的一声回应。你决定不去细听那是回声还是别的什么。",
              "effects": { "sanity": -9 } }
          ]
        }
      ]
    },
    {
      "id": "evt_mine_cart", "title": "矿车轨道", "type": "explore", "pool": ["mine"],
      "weight": 10, "once": false, "cooldownDays": 2,
      "text": "锈蚀的铁轨伸进矿洞深处。一辆还算完整的矿车停在岔口，轨道上方的指示牌歪歪斜斜：「3号矿脉 →」。",
      "options": [
        { "text": "推着矿车沿轨道深入",
