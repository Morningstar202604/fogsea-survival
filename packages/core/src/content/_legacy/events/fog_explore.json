            "effects": { "sanity": -3 } } ]
        }
      ]
    },
    {
      "id": "evt_village_photo", "title": "农舍里的男人", "type": "explore", "pool": ["abandoned_village"],
      "weight": 12, "once": true,
      "text": "废弃村庄的一间农舍里，灶台居然是温的。墙角蜷着一个满脸胡茬的男人，见你进来，缓缓举起双手：「别紧张……我叫老K。」桌上摆着一张旧照片。",
      "options": [
        { "text": "和他搭伙",
          "results": [
            { "weight": 75, "text": "老K会修东西，还懂草药。他说等雾散了一起去找救援队。你多了个同伴。",
              "effects": { "sanity": 12, "setFlags": ["laok_ally"], "companionJoin": true }, "nextEvent": "scene:laok_s1_pact/pact" },
            { "weight": 25, "text": "当晚老K不见了，带走了你半个背包。照片还留在桌上。",
