{
  "events": [
    {
      "id": "evt_edge_driftwood", "title": "漂流木", "type": "explore", "pool": ["fog_edge"],
      "weight": 10, "once": false, "cooldownDays": 2,
      "text": "雾气在脚下流淌。你在一截倒伏的巨木旁停下——木头深处似乎嵌着什么东西，泛着微弱的反光。",
      "options": [
        { "text": "费力撬出来",
          "results": [
            { "weight": 60, "text": "是一把还算完好的手电筒！电池居然还有电。",
              "effects": { "gainItems": [ { "itemId": "tool_flashlight", "count": 1 } ] } },
            { "weight": 40, "text": "只是个空罐头盒。白费力气。",
              "effects": { "sanity": -2 } }
          ]
        },
        { "text": "先劈开木头当柴火",
          "results": [
            { "weight": 100, "text": "干燥的木柴，今晚的火有着落了。",
              "effects": { "sanity": 1, "gainItems": [ { "itemId": "mat_wood", "count": 2 } ] } }
          ]
        }
      ]
    },
    {
      "id": "evt_edge_bottle", "title": "漂流瓶", "type": "explore", "pool": ["fog_edge"],
      "weight": 6, "once": true,
      "text": "浓雾边缘，一只玻璃瓶卡在礁石缝里，瓶中卷着一张纸条：「如果你也看到这张纸——你不是一个人。」",
      "options": [
        { "text": "把纸条小心收好",
          "results": [
            { "weight": 100, "text": "知道有人在同一片迷雾里挣扎着，心里竟然踏实了一些。",
              "effects": { "sanity": 8 }, "chatInject": "link_chest_showoff" }
          ]
        }
      ]
    },
    {
      "id": "evt_edge_ashes", "title": "篝火的余温", "type": "explore", "pool": ["fog_edge"],
      "weight": 9, "once": false, "cooldownDays": 3,
      "text": "一圈石头围着一堆灰烬——有人在这里过夜。灰烬中央似乎还有没烧尽的东西。",
      "options": [
        { "text": "翻找灰烬",
          "results": [
            { "weight": 40, "text": "半截烧焦的布料还能用。主人应该走得不远……",
              "effects": { "gainItems": [ { "itemId": "mat_cloth", "count": 1 } ], "sanity": -4 } },
            { "weight": 35, "text": "只有灰。但灰是温的——就在刚才，还有人坐在这里。",
              "effects": { "sanity": -8 } },
            { "weight": 25, "text": "灰下埋着一个打火机！主人大概是忘了它。",
              "effects": { "gainItems": [ { "itemId": "tool_lighter", "count": 1 } ] } }
          ]
        },
        { "text": "别碰，赶紧离开",
          "results": [ { "weight": 100, "text": "在迷雾里，其他幸存者未必是朋友。",
            "effects": { "sanity": -2 } } ]
        }
      ]
    },
    {
      "id": "evt_edge_mire", "title": "滩涂泥沼", "type": "explore", "pool": ["fog_edge"],
      "weight": 8, "once": false, "cooldownDays": 2,
      "text": "退潮后的滩涂上，泥沼里陷着半个箱子，在雾里若隐若现。泥沼看起来不深——大概。",
      "options": [
        { "text": "卷起裤腿下去挖",
          "results": [
            { "weight": 55, "text": "箱子里是几罐保存完好的罐头！泥浆也算不了什么。",
              "effects": { "gainItems": [ { "itemId": "food_canned", "count": 2 } ] } },
            { "weight": 45, "text": "箱子是空的。而你的一只鞋永远留在了泥沼里，脚也被硬物划伤了。",
              "effects": { "hp": -6, "addStatus": ["injured"], "sanity": -3 } }
          ]
        },
        { "text": "用树枝够一够",
          "requires": {},
          "results": [
            { "weight": 70, "text": "够到了！一小卷绳索从箱缝里滑了出来。",
              "effects": { "gainItems": [ { "itemId": "mat_rope", "count": 1 } ] } },
            { "weight": 30, "text": "树枝断了，箱子纹丝不动。",
              "effects": { "sanity": -2 } }
          ]
        }
      ]
    },
    {
      "id": "evt_forest_boar", "title": "野猪！", "type": "explore", "pool": ["birch_forest"],
      "weight": 12, "once": false, "cooldownDays": 2,
      "text": "灌木丛猛地一颤——一头獠牙发黑的野猪正低头拱土，距离你不到十步。它还没发现你。",
      "options": [
        { "text": "握紧武器冲上去（战斗）",
          "results": [
            { "weight": 50, "text": "搏斗中你被撞翻在地，但最终结果了它。一大块鲜肉！",
              "effects": { "hp": -10, "addStatus": ["injured"], "gainItems": [ { "itemId": "food_raw_meat", "count": 2 } ] } },
            { "weight": 35, "text": "你灵活地爬上了树。野猪撞了几下树干，悻悻离去。",
              "effects": { "hp": -5, "sanity": -4 } },
            { "weight": 15, "text": "野猪的獠牙擦过你的大腿！你连滚带爬才逃开。",
              "effects": { "hp": -18, "addStatus": ["injured", "sick"] } }
          ]
        },
        { "text": "悄悄绕开",
          "results": [
            { "weight": 80, "text": "你屏住呼吸退进树影。它哼了一声，走远了。",
              "effects": { "sanity": -3 } },
            { "weight": 20, "text": "脚下枯枝一声脆响！野猪抬头直视你的方向……你狂奔逃命。",
              "effects": { "hp": -8, "sanity": -8 } }
          ]
        },
        { "text": "【猎手】算好风向，从上风口接近",
          "requires": { "talent": "T06" },
          "results": [
            { "weight": 90, "text": "一击毙命。猎手的直觉从不出错。",
              "effects": { "gainItems": [ { "itemId": "food_raw_meat", "count": 3 } ], "sanity": 5 } }
          ]
        }
      ]
    },
    {
      "id": "evt_forest_mushroom", "title": "蘑菇丛", "type": "explore", "pool": ["birch_forest"],
      "weight": 10, "once": false, "cooldownDays": 1,
      "text": "一棵朽木下长着一片蘑菇，肥厚饱满。其中几朵伞盖泛着不自然的紫色。",
      "options": [
        { "text": "只采白色的",
          "results": [
            { "weight": 85, "text": "安全第一。晚饭有着落了。",
              "effects": { "gainItems": [ { "itemId": "food_berry", "count": 2 } ] } },
            { "weight": 15, "text": "晚上吃完就开始头晕……好像混进去毒蘑菇！",
              "effects": { "addStatus": ["poisoned"] } }
          ]
        },
        { "text": "紫色的也许能卖钱？全采了",
          "results": [
            { "weight": 50, "text": "你赌赢了——这种「雾菇」晒干后是很好的安神药引。",
              "effects": { "gainItems": [ { "itemId": "med_sedative", "count": 1 }, { "itemId": "food_berry", "count": 1 } ] } },
            { "weight": 50, "text": "当晚你就上吐下泻。教训惨痛。",
              "effects": { "hp": -12, "addStatus": ["poisoned"] } }
          ]
        }
      ]
    },
    {
      "id": "evt_forest_old_trap", "title": "捕兽夹", "type": "explore", "pool": ["birch_forest"],
      "weight": 9, "once": false, "cooldownDays": 2,
      "text": "锈迹斑斑的捕兽夹半埋在落叶里，弹簧还绷得紧紧的。夹子上挂着几缕灰白色的毛——不是任何你认识的动物。",
      "options": [
        { "text": "小心拆解它",
          "results": [
            { "weight": 60, "text": "咔哒一声，夹子松开了。弹簧和铁片都是好材料。",
              "effects": { "gainItems": [ { "itemId": "mat_scrap_metal", "count": 1 }, { "itemId": "mat_rope", "count": 1 } ] } },
            { "weight": 40, "text": "咔嚓——夹子猛地弹合，咬住了你的手指！",
              "effects": { "hp": -10, "addStatus": ["injured"] } }
          ]
        },
        { "text": "把它整个搬回去当武器",
          "results": [
            { "weight": 55, "text": "沉是沉了点，但这玩意儿既能防身又能再利用。",
              "effects": { "gainItems": [ { "itemId": "mat_scrap_metal", "count": 2 } ] } },
            { "weight": 45, "text": "搬运途中夹子突然弹开，划破了你的小臂。",
              "effects": { "hp": -8, "addStatus": ["injured"] } }
          ]
        }
      ]
    },
    {
      "id": "evt_forest_sap", "title": "白桦树汁", "type": "explore", "pool": ["birch_forest"],
      "weight": 8, "once": false, "cooldownDays": 2,
      "text": "一棵粗壮的白桦树干上有道旧的切口，树汁正顺着痕迹缓缓渗出，在树下积成一个小水洼。",
      "options": [
        { "text": "切开树皮接树汁",
          "results": [
            { "weight": 75, "text": "清甜微凉的树汁，带着桦树的清香。这是迷雾里少见的温柔。",
              "effects": { "gainItems": [ { "itemId": "water_clean", "count": 1 }, { "itemId": "food_berry", "count": 1 } ], "sanity": 3 } },
            { "weight": 25, "text": "切口流出的汁液发苦发浊——这棵树病了。",
              "effects": { "gainItems": [ { "itemId": "water_dirty", "count": 1 } ] } }
          ]
        },
        { "text": "砍下带切口的树皮引火",
          "results": [
            { "weight": 100, "text": "桦树皮是最好的火引子，一点就着。",
              "effects": { "gainItems": [ { "itemId": "mat_charcoal", "count": 1 }, { "itemId": "mat_wood", "count": 1 } ] } }
          ]
        }
      ]
    },
    {
      "id": "evt_market_pharmacy", "title": "药店柜台", "type": "explore", "pool": ["supermarket"],
      "weight": 11, "once": false, "cooldownDays": 3,
      "conditions": {},
      "text": "超市角落的药店柜台玻璃碎了一地，处方药被搜刮了大半。柜台最里面有个带锁的抽屉，锁扣已经松动。",
      "options": [
        { "text": "撬开抽屉",
          "results": [
            { "weight": 45, "text": "抗生素、止痛药——这一抽屉能救命！",
              "effects": { "gainItems": [ { "itemId": "med_antibiotic", "count": 1 }, { "itemId": "med_painkiller", "count": 1 } ] } },
            { "weight": 35, "text": "只有一堆过期维生素和一本药品说明书。",
              "effects": { "gainItems": [ { "itemId": "med_painkiller", "count": 1 } ], "sanity": -2 } },
            { "weight": 20, "text": "抽屉里盘着一条冬眠的蛇！它受惊咬了你一口就窜走了。",
              "effects": { "hp": -12, "addStatus": ["sick"] } }
          ]
        },
        { "text": "太吵容易招人，放弃",
          "results": [ { "weight": 100, "text": "谨慎点好。你退出了药店区。",
            "effects": { "sanity": -1 } } ]
        }
      ]
    },
    {
      "id": "evt_market_freezer", "title": "冷冻库", "type": "explore", "pool": ["supermarket"],
      "weight": 10, "once": false, "cooldownDays": 2,
      "text": "生鲜区的冷冻库门虚掩着，冷气还在往外冒——这里居然还通着电？货架上的冻肉让你的胃狠狠抽搐了一下。",
      "options": [
        { "text": "冲进去能拿多少拿多少",
          "results": [
            { "weight": 65, "text": "两大块冻肉抱在怀里，透心凉，心里美！",
              "effects": { "gainItems": [ { "itemId": "food_raw_meat", "count": 2 } ] } },
            { "weight": 35, "text": "地面的冰霜滑得像陷阱。你摔了个结实，怀里的肉也掉了一半。",
              "effects": { "hp": -7, "gainItems": [ { "itemId": "food_raw_meat", "count": 1 } ] } }
          ]
        },
        { "text": "研究一下为什么还有电",
          "results": [
            { "weight": 100, "text": "你顺着电线摸过去，发现一台柴油发电机还在低吼。油箱里的存油……被抽走了大半，只留下一层底油和一股汽油味。",
              "effects": { "sanity": -5, "setFlags": ["found_generator"] } }
          ]
        }
      ]
    },
    {
      "id": "evt_creek_fishing", "title": "溪边垂钓", "type": "explore", "pool": ["creek_valley"],
      "weight": 10, "once": false, "cooldownDays": 1,
      "conditions": { "items": [ { "itemId": "tool_fishing_rod", "count": 1 } ] },
      "text": "溪水清澈见底，几条肥美的鱼在卵石间游弋。这里难得没有浓雾。",
      "options": [
        { "text": "下竿垂钓",
          "results": [
            { "weight": 65, "text": "浮漂一顿——两条鱼！今晚加餐。",
              "effects": { "gainItems": [ { "itemId": "food_raw_fish", "count": 2 } ], "sanity": 5 } },
            { "weight": 25, "text": "一下午只有一条小鱼咬钩。",
              "effects": { "gainItems": [ { "itemId": "food_raw_fish", "count": 1 } ] } },
            { "weight": 10, "text": "鱼没钓到，倒是脚底滑进溪水里，浑身湿透。",
              "effects": { "sanity": -5 } }
          ]
        },
        { "text": "顺便灌满水壶",
          "results": [
            { "weight": 100, "text": "上游的水很干净，直接喝也没大碍。",
              "effects": { "gainItems": [ { "itemId": "water_clean", "count": 2 } ] } }
          ]
        }
      ]
    },
    {
      "id": "evt_creek_upstream", "title": "上游漂来的东西", "type": "explore", "pool": ["creek_valley"],
      "weight": 9, "once": false, "cooldownDays": 2,
      "text": "上游漂下来一个鼓鼓囊囊的防水包，卡在了两块岩石之间。包身写着一行褪色的字：户外用品店·促销。",
      "options": [
        { "text": "下水去捞",
          "results": [
            { "weight": 60, "text": "包里是一条崭新的鱼线和一把多功能刀片！今天运气不错。",
              "effects": { "gainItems": [ { "itemId": "mat_rope", "count": 1 }, { "itemId": "mat_scrap_metal", "count": 1 } ] } },
            { "weight": 40, "text": "水流比看上去急得多！你呛了好几口水才爬上岸，包也漂走了。",
              "effects": { "hp": -8, "sanity": -6, "gainItems": [ { "itemId": "water_dirty", "count": 1 } ] } }
          ]
        },
        { "text": "用鱼竿把包勾过来",
          "requires": { "items": [ { "itemId": "tool_fishing_rod", "count": 1 } ] },
          "results": [
            { "weight": 85, "text": "工具用对了地方。包里的东西一件不少。",
              "effects": { "gainItems": [ { "itemId": "mat_rope", "count": 1 }, { "itemId": "mat_cloth", "count": 1 } ], "sanity": 3 } }
          ]
        }
      ]
    },
    {
      "id": "evt_creek_reflection", "title": "水中倒影", "type": "explore", "pool": ["creek_valley"],
      "weight": 8, "once": false, "cooldownDays": 3,
      "conditions": { "stats": { "sanity": { "op": "<=", "value": 55 } } },
      "text": "你在溪边蹲下想洗把脸。水面平静下来的那一刻，倒影里的「你」比你慢了半拍才抬手。",
      "options": [
        { "text": "死死盯住它，看谁先眨眼",
          "results": [
            { "weight": 40, "text": "对峙了不知多久，「它」先散开了。溪水依旧清澈。你忽然觉得没那么怕了——连自己的影子都吓不住你。",
              "effects": { "sanity": 12, "setFlags": ["faced_reflection"] } },
            { "weight": 60, "text": "倒影突然咧嘴笑了。你踉跄着后退，溅起的水花打碎了那张脸。",
              "effects": { "sanity": -14, "hp": -3 } }
          ]
        },
        { "text": "立刻转身离开，不再看水",
          "results": [ { "weight": 100, "text": "眼不见为净。但那一整天，你都在回想那慢掉的半拍。",
            "effects": { "sanity": -7 } } ]
        }
      ]
    },
    {
      "id": "evt_village_cellar", "title": "农舍地窖", "type": "explore", "pool": ["abandoned_village"],
      "weight": 11, "once": true,
      "text": "一间半塌的农舍后面，一扇木门斜嵌在地里——地窖。门轴锈死了，门缝里飘出陈腐的气息，以及……若有若无的食物味。",
      "options": [
        { "text": "打开手电筒下去",
          "requires": { "items": [ { "itemId": "tool_flashlight", "count": 1 } ] },
          "results": [
            { "weight": 70, "text": "光柱扫过：整整齐齐两排储物架！罐头、腊肠、腌菜……这家人走得一定很匆忙。",
              "effects": { "gainItems": [ { "itemId": "food_canned", "count": 2 }, { "itemId": "food_biscuit", "count": 1 } ], "sanity": 5 } },
            { "weight": 30, "text": "架子上的食物早就烂透了。但角落里有只完好的急救箱。",
              "effects": { "gainItems": [ { "itemId": "med_first_aid", "count": 1 } ] } }
          ]
        },
        { "text": "摸黑下去",
          "results": [
            { "weight": 35, "text": "你凭着触觉摸到了几个罐头，赶紧逃出了黑暗。",
              "effects": { "gainItems": [ { "itemId": "food_canned", "count": 1 } ], "sanity": -8 } },
            { "weight": 65, "text": "第三级台阶是空的！你重重摔进黑暗里，有什么液体淋了一头。你连滚带爬冲向门口的光亮。",
              "effects": { "hp": -14, "addStatus": ["injured"], "sanity": -12 } }
          ]
        },
        { "text": "做个记号，改日再来",
          "results": [ { "weight": 100, "text": "工欲善其事，必先利其器。至少要等有光源再说。",
            "effects": {} } ]
        }
      ]
    },
    {
      "id": "evt_village_well", "title": "古井", "type": "explore", "pool": ["abandoned_village"],
      "weight": 9, "once": true,
      "text": "村子中央有一口古井。你朝井底扔了颗石子——很久很久之后，传来一声轻响。不对，井没那么深。而且刚才那声音……像是被什么软东西接住的。",
      "options": [
        { "text": "吊着绳子下去看看",
          "requires": { "items": [ { "itemId": "mat_rope", "count": 1 } ] },
