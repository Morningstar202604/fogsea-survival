{
  "events": [
    {
      "id": "evt_daily_dew", "title": "晨露", "type": "daily",
      "weight": 10, "once": false, "cooldownDays": 2,
      "text": "清晨，木屋外的草叶上凝满了露水。这是迷雾世界少有的馈赠。",
      "options": [
        { "text": "收集露水",
          "results": [ { "weight": 100, "text": "一壶清凉的露水。虽然不多，但干净。",
            "effects": { "gainItems": [ { "itemId": "water_clean", "count": 1 } ] } } ]
        }
      ]
    },
    {
      "id": "evt_daily_radio_news", "title": "收音机的杂音", "type": "daily",
      "weight": 8, "once": false, "cooldownDays": 1,
      "text": "你摆弄着捡来的旧收音机。刺啦刺啦的杂音里，隐约夹着断续的人声广播。",
      "options": [
        { "text": "仔细辨认内容",
          "results": [
            { "weight": 60, "text": "「……救援船将于近期抵达东部海岸线……请幸存者……」你把频道记了下来。",
              "effects": { "sanity": 6, "setFlags": ["heard_rescue_news"] } },
            { "weight": 40, "text": "只有杂音。也许只是风声。",
              "effects": { "sanity": -3 } }
          ]
        }
      ]
    },
    {
      "id": "evt_daily_rat", "title": "雾鼠", "type": "daily",
      "weight": 10, "once": false, "cooldownDays": 2,
      "conditions": {},
      "text": "一只硕大的灰白老鼠大摇大摆地穿过你的木屋，嘴里还叼着什么。",
      "options": [
        { "text": "追打它",
          "results": [
            { "weight": 55, "text": "雾鼠丢下赃物逃了。你夺回了一块肉干——虽然已经脏了。",
              "effects": { "hp": -2, "gainItems": [ { "itemId": "food_raw_meat", "count": 1 } ] } },
            { "weight": 45, "text": "它钻进墙缝消失了。你的储备又少了一点。",
              "effects": { "sanity": -4 } }
          ]
        },
        { "text": "随它去",
          "results": [ { "weight": 100, "text": "只要它别再带朋友来就行。",
            "effects": { "sanity": -2 } } ]
        }
      ]
    },
    {
      "id": "evt_daily_birds", "title": "鸟群惊飞", "type": "daily",
      "weight": 8, "once": false, "cooldownDays": 2,
      "text": "一大群鸟突然从林子方向炸开般飞起，盘旋着不肯落下。它们在怕什么？",
      "options": [
        { "text": "记下方位，今天避开那边",
          "results": [ { "weight": 100, "text": "直觉救过很多次命了。你把那个方向刻在了门框上。",
            "effects": { "sanity": -1, "setFlags": ["birds_warned"] } } ]
        },
        { "text": "鸟都跑了说明没危险？照常探索",
          "results": [ { "weight": 100, "text": "一整天你都感觉背后有视线。晚上回想起来，还是后颈发凉。",
            "effects": { "sanity": -4 } } ]
        }
      ]
    },
    {
      "id": "evt_daily_smoke", "title": "远处的烟柱", "type": "daily",
      "weight": 8, "once": true,
      "text": "透过雾隙，你看见远处升起一道笔直的烟柱——有人在你附近生火。而且那烟烧得又直又旺，像是在刻意打招呼。",
      "options": [
        { "text": "也生一堆烟回应（消耗木材）",
          "results": [
            { "weight": 70, "text": "对面的烟柱欢快地扭了一下，随后熄灭——像是完成了任务。世界频道上多了一句：「东边的朋友你好呀」。你笑了。",
              "effects": { "sanity": 10, "loseItems": [ { "itemId": "mat_wood", "count": 1 } ], "chatInject": "link_gift" } },
            { "weight": 30, "text": "你的烟刚起来，对面瞬间熄灭了。之后那里再没有升起过烟。",
              "effects": { "sanity": -8 } }
          ]
        },
        { "text": "保持隐蔽，观察一天",
          "results": [ { "weight": 100, "text": "你趴在窗口看了一整天。烟柱的主人很谨慎，你们谁也没找到谁。",
            "effects": { "sanity": -3 } } ]
        }
      ]
    },
    {
      "id": "evt_daily_carving", "title": "门框上的刻痕", "type": "daily",
      "weight": 7, "once": true,
      "text": "你整理木屋时发现门框内侧刻着密密麻麻的正字，最下面一行小字：「第9天 我还活着 你们也要活下去」。最后几刀明显没了力气。",
      "options": [
        { "text": "在旁边刻上自己的正字",
          "results": [ { "weight": 100, "text": "一刀一刀，你把「第一天」刻得很深。从今天起，这间屋子的门框上有两个人的日子。",
            "effects": { "sanity": 7 } } ]
        }
      ]
    },
    {
      "id": "evt_daily_dream_family", "title": "梦", "type": "daily",
      "weight": 8, "once": false, "cooldownDays": 3,
      "text": "夜里你梦见了家：厨房的灯、沙发的凹陷、阳台上晾着没干的衣服。醒来时枕头湿了一片，屋里冷得像冰窖。",
      "options": [
        { "text": "把梦里的细节写在墙上",
          "results": [ { "weight": 100, "text": "「厨房灯是暖黄色的。」写下来的瞬间，那些东西就永远不会丢了。你要活着回去核对每一个细节。",
            "effects": { "sanity": 9 } } ]
        },
        { "text": "不敢回想，立刻起身干活",
          "results": [ { "weight": 100, "text": "麻木是很好的止痛药。你劈了一上午柴，手掌磨出了血泡也没觉得疼。",
            "effects": { "hp": -2, "sanity": -3, "gainItems": [ { "itemId": "mat_wood", "count": 1 } ] } } ]
        }
      ]
    },
    {
      "id": "evt_daily_tooth", "title": "牙齿松动", "type": "daily",
      "weight": 6, "once": false, "cooldownDays": 4,
      "conditions": {},
      "text": "早上啃黑面包时，一颗牙晃了。你对着水洼照了照——牙龈苍白，嘴唇也裂着。你的身体开始抗议了。",
      "options": [
        { "text": "省着点吃，把好的留给明天",
          "results": [ { "weight": 100, "text": "细水长流。虽然还是饿，但至少不用和自己的牙较劲。",
            "effects": { "hunger": -3, "sanity": -1 } } ]
        },
        { "text": "该吃吃！身体是撑出来的",
          "results": [ { "weight": 100, "text": "你狠狠嚼完了双份口粮。牙齿的问题……以后再说吧。",
            "effects": { "hp": -2, "sanity": 2 } } ]
        }
      ]
    },
    {
      "id": "evt_daily_rain_mushroom", "title": "雨后菌子", "type": "daily",
      "weight": 7, "once": false, "cooldownDays": 3,
      "conditions": { "weathers": ["rain", "fog_light"] },
      "text": "昨夜下过雨，屋后的腐木上冒出了一片嫩菌子。迷雾世界的菌子长得格外快，也格外……随机。",
      "options": [
        { "text": "挑小的采",
          "results": [ { "weight": 80, "text": "小菌子最安全，这是老饕的常识。今晚加菜！",
            "effects": { "gainItems": [ { "itemId": "food_berry", "count": 2 } ] } },
          { "weight": 20, "text": "还是有两条漏网之鱼混进锅里了……半夜你抱着肚子在屋里转圈。",
            "effects": { "addStatus": ["sick"] } } ]
        },
        { "text": "全采全晒，存起来",
          "results": [ { "weight": 100, "text": "晒干后能放很久。万一哪天断粮，这些干菌子就是救命稻草。",
            "effects": { "gainItems": [ { "itemId": "food_berry", "count": 1 }, { "itemId": "mat_charcoal", "count": 1 } ] } } ]
        }
      ]
    },
    {
      "id": "evt_daily_knock_help", "title": "频道里的求助", "type": "daily",
      "weight": 8, "once": false, "cooldownDays": 4,
      "text": "世界频道上，一个坐标离你不远的幸存者发消息：「谁有多余的水 我三天没喝干净水了 好心人有吗」。",
      "options": [
        { "text": "送他一份净水",
          "requires": { "items": [ { "itemId": "water_clean", "count": 1 } ] },
          "results": [ { "weight": 100, "text": "你把水放在了约定的石头下。傍晚路过时，石头上多了一把野蜂蜜。「谢谢。活下去。」——人心在雾里也能传热。",
            "effects": { "loseItems": [ { "itemId": "water_clean", "count": 1 } ], "sanity": 12, "gainItems": [ { "itemId": "food_berry", "count": 1 } ] } } ]
        },
        { "text": "送一份脏水（也是心意）",
          "results": [ { "weight": 100, "text": "「谢了 聊胜于无」。频道那头的语气听不出喜怒。但至少你出手了。",
            "effects": { "loseItems": [ { "itemId": "water_dirty", "count": 1 } ], "sanity": 5 } } ]
        },
        { "text": "自己也快断了，装没看见",
          "results": [ { "weight": 100, "text": "那条求助消息后来没有更新了。你告诉自己：先活下来的人才有资格谈善良。",
            "effects": { "sanity": -6 } } ]
        }
      ]
    },
    {
      "id": "evt_daily_exercise", "title": "晨间操", "type": "daily",
      "weight": 7, "once": false, "cooldownDays": 2,
      "text": "难得的晴朗间隙。你在木屋前伸了个懒腰，决定活动一下僵硬的身体——毕竟在这个世界，身体是唯一的本钱。",
      "options": [
        { "text": "做一套广播体操（第七套）",
          "results": [ { "weight": 100, "text": "熟悉的口号让肌肉都记起了学生时代。微微出汗，浑身舒畅。",
            "effects": { "sanity": 6, "hp": 2 } } ]
        },
        { "text": "算了，多睡十分钟",
          "results": [ { "weight": 100, "text": "被窝是人类最伟大的发明。虽然起来时更冷了，但精神确实好了些。",
            "effects": { "sanity": 3 } } ]
        }
      ]
    },
    {
      "id": "evt_daily_channel_fight", "title": "频道里的争吵", "type": "daily",
      "weight": 8, "once": false, "cooldownDays": 2,
      "text": "世界频道上两个人吵起来了：「你凭什么拿走我藏的箱子！」「迷雾里的东西没有主人！」几百人在围观，还有人开了赌盘猜谁赢。",
      "options": [
        { "text": "围观吃瓜",
          "results": [ { "weight": 100, "text": "吵了整整一上午，最后两人约在雾里单挑。频道安静了一小时后，有人发了句「人没了」。全场沉默。你默默关掉了面板。",
            "effects": { "sanity": -5 } } ]
        },
        { "text": "发一句：都少说两句 囤货要紧",
          "results": [ { "weight": 100, "text": "你的发言被顶到了热评第一。争吵不了了之。理性的人还是比想象中多一点。",
            "effects": { "sanity": 4 } } ]
        }
      ]
    },
    {
      "id": "evt_daily_old_news", "title": "旧报纸", "type": "daily",
      "weight": 6, "once": true,
      "text": "你在柜子底层翻出一叠穿越前的旧报纸。头条日期是灾难前一天：「本市明日有雾 出行请注意安全」。命运开了一个巨大的玩笑。",
      "options": [
        { "text": "仔细读一遍这些新闻",
          "results": [ { "weight": 100, "text": "菜价、球赛、明星八卦……这些琐碎到可笑的日常，现在读来字字珍贵。你把报纸仔细收好：这是文明存在过的证据。",
            "effects": { "sanity": 8 } } ]
        },
        { "text": "拿来引火",
          "results": [ { "weight": 100, "text": "头版头条烧得最快。火焰里有油墨的味道，像是在替那个世界说最后的告别。",
            "effects": { "sanity": -4, "gainItems": [ { "itemId": "mat_charcoal", "count": 1 } ] } } ]
        }
      ]
    }
  ]
}
