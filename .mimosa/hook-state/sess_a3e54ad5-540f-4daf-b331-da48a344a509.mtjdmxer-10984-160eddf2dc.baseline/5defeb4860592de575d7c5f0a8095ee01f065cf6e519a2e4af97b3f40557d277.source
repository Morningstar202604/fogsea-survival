          { kind: 'flag', flag: 'ignored_crystals', flagValue: true },
        ],
        next: '__return__',
        result: '你选择远离这些诡异的晶体。虽然有些遗憾，但至少保证了安全。',
      },
      {
        id: 'study_crystals',
        text: '先研究一下（需要智力≥12）',
