/**
 * v2.0 主线剧情 - 结晶线
 * 
 * 剧情简介：在探索中发现神秘紫色结晶，蕴含强大能量。
 * 主角踏上收集结晶、觉醒力量的旅程，逐步揭开迷雾世界的超凡秘密。
 */

import type { StorylineDef, SceneNode, EndingDef } from '../types.js';

/** 结晶线结局定义 */
export const CRYSTAL_ENDINGS: Record<string, EndingDef> = {
  crystal_master: {
    id: 'crystal_master',
    title: '结晶大师',
    desc: '你成功掌握了结晶的力量，成为迷雾世界中少数能够驾驭超凡之力的强者。你的身体已经与结晶融合，获得了近乎永恒的生命。但这力量也让你逐渐远离人性...',
    category: 'true',
  },
  power_corruption: {
    id: 'power_corruption',
    title: '力量腐蚀',
    desc: '过度依赖结晶力量让你的心智逐渐扭曲。你开始视普通幸存者为蝼蚁，沉迷于力量的快感中无法自拔。最终，你成为了自己曾经对抗的怪物...',
    category: 'bad',
  },
  balance_keeper: {
    id: 'balance_keeper',
    title: '平衡守护者',
    desc: '你找到了使用结晶力量的平衡点，既不完全依赖也不完全拒绝。你用这份力量保护弱者，维持幸存者社区的秩序。你是迷雾中的希望之光。',
    category: 'good',
  },
  crystal_explosion: {
    id: 'crystal_explosion',
    title: '结晶爆炸',
    desc: '在一次实验中，结晶能量失控引发大爆炸。你和周围的一切都被吞噬在紫色的光芒中...也许这是解脱，也许是新的开始。',
    category: 'death',
  },
};

/** 结晶线场景节点 */
export const CRYSTAL_SCENES: Record<string, SceneNode> = {
  // === 触发场景 ===
  crystal_discovery: {
    id: 'crystal_discovery',
    text: `【第${'{day}'}天】

你在深入迷雾森林探索时，发现了一个奇异的洞穴。洞穴深处散发着微弱的紫色光芒。

走近一看，地面上散落着一些拳头大小的紫色晶体。它们似乎在呼吸般闪烁着，给人一种既危险又诱人的感觉。

当你伸手触碰其中一块时，一股暖流瞬间传遍全身。你能感觉到体内有什么东西被唤醒了...

【系统提示】发现神秘结晶！是否收集？`,
    choices: [
      {
        id: 'collect_crystals',
        text: '收集结晶（获得x3）',
