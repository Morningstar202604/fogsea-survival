        effects: [
          { kind: 'item', item: 'mysterious_crystal', amount: 3 },
          { kind: 'flag', flag: 'crystal_line_started', flagValue: true },
          { kind: 'resource', resource: 'sanity', delta: -5 },
          { kind: 'jump', target: 'crystal_first_touch' },
        ],
        next: 'crystal_first_touch',
        result: '你小心翼翼地收集了3块结晶。它们的温度比周围环境略高，仿佛有生命一般...',
