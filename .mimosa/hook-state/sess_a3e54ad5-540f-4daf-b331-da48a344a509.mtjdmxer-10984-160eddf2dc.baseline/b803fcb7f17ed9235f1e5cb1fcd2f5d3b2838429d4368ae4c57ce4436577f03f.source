name: CI

on:
  push:
    branches: [main]
  pull_request:

jobs:
  verify:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7

      - uses: pnpm/action-setup@v6

      - uses: actions/setup-node@v7
        with:
          node-version: 22
          cache: pnpm

      - name: 安装依赖
        run: pnpm install --frozen-lockfile

      - name: 构建 core 包（生成最新类型声明）
        run: pnpm -F @fogsea/core build

      - name: 类型检查（core + web）
        run: pnpm typecheck

      - name: 单元测试（71 用例）
        run: pnpm test

      - name: 内容校验（387 事件 / 44 支线 / 14 结局）
        run: pnpm validate

      - name: 全量构建
        run: pnpm build
