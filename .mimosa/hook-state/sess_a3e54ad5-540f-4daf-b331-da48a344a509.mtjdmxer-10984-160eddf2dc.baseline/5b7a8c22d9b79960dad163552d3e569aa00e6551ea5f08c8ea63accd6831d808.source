import { describe, it, expect } from 'vitest';
import { fullContent } from './content/full.js';
import {
  createInitialState,
  runDaily,
  importState,
  Rng,
  processSignin,
  ACHIEVEMENTS,
  checkAchievements,
  executeCombatRound,
  type CombatSession,
} from './index.js';

describe('每日签到', () => {
  it('连签累加且按 7 天周期发奖', () => {
    const s = createInitialState(fullContent);
    const wood0 = s.inventory['wood'] ?? 0;
    const msg1 = processSignin(s);
    expect(s.runStats.signinStreak).toBe(1);
    expect(msg1).toContain('第 1 天');
    expect(s.inventory['wood']).toBe(wood0 + 10);
    // 连签 6 天后（streak=6），第 7 次签到应发周大奖（木矛×1）
    for (let i = 0; i < 5; i++) processSignin(s);
    expect(s.runStats.signinStreak).toBe(6);
    const spear = s.inventory['wooden_spear'] ?? 0;
    processSignin(s);
    expect(s.runStats.signinStreak).toBe(7);
    expect(s.inventory['wooden_spear']).toBe(spear + 1);
    // 第 8 天回到周期第 1 天：不再发矛
    processSignin(s);
    expect(s.runStats.signinStreak).toBe(8);
    expect(s.inventory['wooden_spear']).toBe(spear + 1);
  });

  it('runDaily 首日包含签到播报', () => {
    const s = createInitialState(fullContent);
    const r = runDaily(fullContent, s, new Rng(1));
    expect(r.messages.some((m) => m.includes('【签到】'))).toBe(true);
  });
});

describe('战斗遭遇接入主循环', () => {
  it('第 3 天前不触发遭遇（runDaily 内 day 递增后仍 <3）', () => {
    for (let seed = 1; seed <= 20; seed++) {
      const s = createInitialState(fullContent);
      s.day = 1; // 结算后进入第 2 天，仍小于遭遇起始日 3
      const r = runDaily(fullContent, s, new Rng(seed));
      expect(s.combat).toBeUndefined();
      void r;
    }
  });

  it('200 天大量抽样必然出现遭遇战且会话合法', () => {
    let seen = false;
    for (let seed = 1; seed <= 50 && !seen; seed++) {
      const s = createInitialState(fullContent, undefined, 'strong_body');
      for (let d = 1; d <= 20 && !seen; d++) {
        const r = runDaily(fullContent, s, new Rng(seed * 100 + d));
        if (r.dead) break;
        if (s.combat) {
          seen = true;
          expect(s.combat.enemyMaxHp).toBeGreaterThan(0);
          expect(s.combat.log.length).toBeGreaterThan(0);
        }
      }
    }
    expect(seen).toBe(true);
  });

  it('击杀结算：掉落入背包、击杀数累加', () => {
    const s = createInitialState(fullContent, undefined, 'strong_body');
    s.day = 5;
    s.progression.currentWorldTier = 2;
    // 直接构造一场快赢战斗：打空野狗血量
    const inv0 = { ...s.inventory };
    const r = runDaily(fullContent, s, new Rng(3));
    void r;
    if (s.combat) {
      const session: CombatSession = s.combat;
      let guard = 0;
      let ended = false;
      let result = undefined as ReturnType<typeof executeCombatRound>['result'];
      while (!ended && guard++ < 200) {
        const r2 = executeCombatRound(s, session, 'attack', new Rng(guard));
        s.combat = r2.session;
        ended = r2.ended;
        result = r2.result;
      }
      if (result?.victory) {
        expect(s.runStats.kills).toBe(1);
        const looted = Object.keys(result.loot);
        for (const id of looted) {
          expect(s.inventory[id]).toBeGreaterThan(inv0[id] ?? 0);
        }
      }
    }
  });
});

describe('成就系统', () => {
  it('达到条件即解锁并写入 meta，重复检查不重复解锁', () => {
    const s = createInitialState(fullContent);
    s.day = 8;
    const first = checkAchievements(s);
    expect(first.some((a) => a.id === 'survivor_7')).toBe(true);
    expect(s.meta.unlockedAchievements).toContain('survivor_7');
    const again = checkAchievements(s);
    expect(again.some((a) => a.id === 'survivor_7')).toBe(false);
  });

  it('成就目录包含 12 枚且 id 唯一', () => {
    expect(ACHIEVEMENTS.length).toBe(12);
    expect(new Set(ACHIEVEMENTS.map((a) => a.id)).size).toBe(12);
  });

  it('runDaily 播报成就达成', () => {
    const s = createInitialState(fullContent, undefined, 'scavenge_master');
    const r = runDaily(fullContent, s, new Rng(1));
    expect(r.messages.some((m) => m.includes('【成就达成】'))).toBe(true);
  });
});

describe('v1.0 存档兼容', () => {
  it('runStats 新字段旧档导入后补 0，成就字段补空', () => {
    const s = createInitialState(fullContent);
    s.runStats.kills = 3;
    s.runStats.signinStreak = 5;
    const legacy = JSON.parse(JSON.stringify(s));
    delete legacy.runStats.kills;
    delete legacy.runStats.signinStreak;
    delete legacy.meta.unlockedAchievements;
    // 走 importState 需要合法编码：直接改 JSON 后重新导出
    const json = JSON.stringify(legacy);
    const b64 = Buffer.from(json, 'utf8').toString('base64');
    let crc = 0xffffffff;
    for (let i = 0; i < json.length; i++) {
      let c = (crc ^ json.charCodeAt(i)) & 0xff;
      for (let k = 0; k < 8; k++) c = c & 1 ? 0xedb88320 ^ (c >>> 1) : c >>> 1;
      crc = (c ^ (crc >>> 8)) >>> 0;
    }
    const back = importState(`${b64}:${((crc ^ 0xffffffff) >>> 0).toString(16).padStart(8, '0')}`)!;
    expect(back.runStats.kills).toBe(0);
    expect(back.runStats.signinStreak).toBe(0);
    expect(back.meta.unlockedAchievements).toEqual([]);
  });
});
