// ============================================================
// 四、合并函数
// ============================================================

/**
 * 将第二阶段内容合并到主内容包中
 */
export function mergePhase2Content(content: any): any {
  content.storyline.scenes = {
    ...content.storyline.scenes,
    ...PHASE2_SCENES,
  };
  if (!content.randomEvents) content.randomEvents = [];
  content.randomEvents = [...content.randomEvents, ...PHASE2_EVENTS];
  return content;
}
