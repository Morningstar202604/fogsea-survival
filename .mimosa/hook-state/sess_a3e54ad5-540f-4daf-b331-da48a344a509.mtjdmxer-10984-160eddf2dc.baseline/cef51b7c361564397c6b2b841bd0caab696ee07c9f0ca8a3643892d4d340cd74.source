import type { RollTier } from './types.js';

/**
 * 掷骰检定（d100）：成功阈值为 (100 - difficulty)，即
 * - 大成功: roll >= 95
 * - 成功:   roll >= (100 - difficulty)
 * - 失败:   roll >= 30（且有难度门槛）
 * - 大失败: roll <= 10
 *
 * difficulty 越高越难成功。返回档位 + 具体点数。
 */
export interface RollResult {
  roll: number;
  tier: RollTier;
  success: boolean;
}

export function rollD100(rng: () => number, difficulty: number, bonus: number = 0): RollResult {
  const raw = Math.floor(rng() * 100) + 1; // 1..100
  const roll = Math.max(1, Math.min(100, raw + bonus));
  const threshold = 100 - difficulty; // difficulty=30 → 70 及以上成功
  const success = roll >= threshold;
  let tier: RollTier;
  if (success) {
    tier = roll >= 95 ? 'crit_success' : 'success';
  } else {
    tier = roll <= 10 ? 'crit_fail' : 'fail';
  }
  return { roll, tier, success };
}

/** 命中判定用于生成检定结果文本 */
export function tierLabel(tier: RollTier): string {
  switch (tier) {
    case 'crit_success':
      return '大成功';
    case 'success':
      return '成功';
    case 'fail':
      return '失败';
    case 'crit_fail':
      return '大失败';
  }
}
