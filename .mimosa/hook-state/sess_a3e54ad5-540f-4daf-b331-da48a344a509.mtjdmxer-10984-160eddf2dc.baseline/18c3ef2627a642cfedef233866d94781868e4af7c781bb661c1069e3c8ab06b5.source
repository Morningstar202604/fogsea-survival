// ============================================================
// 五、合并函数
// ============================================================

/**
 * 将第五阶段内容合并到主内容包中
 */
export function mergePhase5Content(content: any): any {
  content.storyline.scenes = {
    ...content.storyline.scenes,
    ...PHASE5_SCENES,
  };
  if (!content.randomEvents) content.randomEvents = [];
  content.randomEvents = [...content.randomEvents, ...PHASE5_EVENTS];
  return content;
}
