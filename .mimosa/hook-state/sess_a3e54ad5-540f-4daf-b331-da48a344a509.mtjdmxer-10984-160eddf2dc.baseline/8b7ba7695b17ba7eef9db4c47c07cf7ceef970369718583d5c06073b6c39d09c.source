import { describe, it, expect } from 'vitest';
import { fullContent } from './content/full.js';
import {
  createInitialState,
  runDaily,
  buildStructure,
  upgradeBase,
  evaluateCatastrophe,
  sellToMerchant,
  computeRank,
  recruitCompanion,
  isRecruited,
  getCompanionDefense,
  Rng,
} from './index.js';
import { CATASTROPHE_EVENTS } from './progression.js';

describe('队友招募与联盟协防', () => {
  const wave1 = CATASTROPHE_EVENTS.find((e) => e.id === 'beast_wave_tier1')!;

  it('招募门槛：好感不足拒绝，达标后入队', () => {
    const s = createInitialState(fullContent);
    expect(recruitCompanion(s, 'laok', 20)).toBeNull();
    expect(isRecruited(s, 'laok')).toBe(false);
    const msg = recruitCompanion(s, 'laok', 30);
    expect(msg).toContain('老K');
    expect(isRecruited(s, 'laok')).toBe(true);
    expect(recruitCompanion(s, 'laok', 99)).toBeNull(); // 已入队幂等
  });

  it('同伴每日被动生效（林医生生命+3）', () => {
    const s = createInitialState(fullContent);
    s.flags['companion_doc'] = true;
    const before = s.resources.health.current;
    const r = runDaily(fullContent, s, new Rng(1));
    expect(r.messages.some((m) => m.includes('林医生'))).toBe(true);
    expect(s.resources.health.current).toBeGreaterThanOrEqual(before); // +3 抵消当日消耗
  });

  it('协防计入天灾判定：同伴让一级兽潮可守住', () => {
    const s = createInitialState(fullContent);
    s.base.level = 2; // 满足 minBaseLevel=2，但工事为 0
    expect(evaluateCatastrophe(s as any, wave1).success).toBe(false);
    s.flags['companion_laok'] = true;   // 协防 30
    s.flags['companion_rescue'] = true; // 协防 20
    expect(getCompanionDefense(s)).toBe(50);
    const verdict = evaluateCatastrophe(s as any, wave1);
    expect(verdict.success).toBe(true);
  });

  it('工事路线同样可守住：造 5 座木刺 = 50 防御', () => {
    const s = createInitialState(fullContent);
    // 走正规升级链到 3 级（容量 10；直接改 level 不会同步容量）
    s.inventory['wood'] = 3000;
    s.inventory['stone'] = 1000;
    s.inventory['metal'] = 500;
    upgradeBase(s as any);
    upgradeBase(s as any);
    expect(s.base.level).toBe(3);
    expect(s.base.capacity.maxStructures).toBe(10);
    s.inventory['wood'] = 500;
    for (let i = 0; i < 5; i++) {
      const r = buildStructure(s as any, 'wooden_spike', { x: i, y: 0 });
      expect(r.success).toBe(true);
    }
    expect(s.base.totalDefense).toBe(50);
    expect(evaluateCatastrophe(s as any, wave1).success).toBe(true);
  });

  it('同伴声望推高排行榜排名', () => {
    const s = createInitialState(fullContent);
    s.day = 30;
    const before = computeRank(s);
    s.flags['companion_rescue'] = true;
    s.flags['companion_laok'] = true;
    expect(computeRank(s)).toBeLessThan(before);
  });

  it('鼠王谈判力：出售价 +10%', () => {
    const s = createInitialState(fullContent);
    s.economy.marketPrices['wood'] = { itemId: 'wood', currentPrice: 100, basePrice: 5, demand: 1, supply: 1, lastUpdated: 1, priceHistory: [] };
    s.inventory['wood'] = 100;
    const s2 = JSON.parse(JSON.stringify(s));
    sellToMerchant(s as any, 'wandering_trader', 'wood', 1);
    const normal = s.economy.currency;
    s2.flags['companion_rat'] = true;
    sellToMerchant(s2 as any, 'wandering_trader', 'wood', 1);
    expect(s2.economy.currency).toBeGreaterThan(normal);
  });

  it('升级链修复后可达 4 级（原 blueprint 不可获得导致断裂）', () => {
    const s = createInitialState(fullContent);
    s.inventory['wood'] = 2000;
    s.inventory['stone'] = 2000;
    s.inventory['metal'] = 1000;
    // 1→2
    expect(upgradeBase(s as any).success).toBe(true);
    expect(s.base.level).toBe(2);
    // 2→3
    s.inventory['wood'] = 2000;
    expect(upgradeBase(s as any).success).toBe(true);
    expect(s.base.level).toBe(3);
    // 3→4（原需 blueprint×5，已改为可达成材料）
    s.inventory['wood'] = 2000;
    expect(upgradeBase(s as any).success).toBe(true);
    expect(s.base.level).toBe(4);
  });
});
